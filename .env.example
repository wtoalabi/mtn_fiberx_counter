# Local-only dashboard and router settings. Copy this file to .env, replace
# both password placeholders, and keep the file owner-readable (chmod 600).
# This dashboard password is entered on the local sign-in page and is never
# generated into data/ or sent to the router.
DASHBOARD_PASSWORD=replace-with-a-unique-password-of-20-or-more-characters
# Router integration: auto detects the Airtel ODU command API and otherwise
# uses the Huawei FiberX WAN-statistics integration. Use zlt or huawei to pin it.
ROUTER_SOURCE=auto
ROUTER_URL=https://192.168.100.1
# MTN FiberX / Huawei router credentials.
ROUTER_USERNAME=root
ROUTER_PASSWORD=replace-with-your-router-password
# Airtel ODU credentials. These are used only when the active source is zlt.
AIRTEL_ROUTER_USERNAME=replace-with-your-airtel-odu-username
AIRTEL_ROUTER_PASSWORD=replace-with-your-airtel-odu-password
ROUTER_ALLOW_PLAINTEXT_HTTP=false
ROUTER_INSECURE_TLS=false
# Preferred for a self-signed HTTPS certificate; leave blank for normal CA verification.
# For the Airtel ODU, use its HTTPS address (normally https://192.168.1.1) and
# the SHA-256 fingerprint verified from that device. Do not disable TLS just
# because the ODU uses a self-signed certificate.
ROUTER_TLS_FINGERPRINT256=
USAGE_TIMEZONE=Africa/Lagos
PORT=3000
